[include]
	path = ~/.gitconfig.local
	path = ~/dotfiles/config/delta/themes.gitconfig
[core]
	excludesfile = ~/.git-global-ignore
	editor = nvim
	pager = delta
	precomposeunicode = true
[difftool]
	prompt = false
[diff]
	tool = nvimdiff
[difftool "nvimdiff"]
	cmd = nvim -d $LOCAL $REMOTE
[merge]
	tool = nvimdiff
[mergetool]
	prompt = false
[mergetool "nvimdiff"]
	cmd = nvim -d $BASE $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'
[color]
	diff = auto
	status = auto
	branch = auto
[alias]
	a = add
	b = branch
	bd = branch -d
	bdf = branch -D
	c = commit
	co = checkout
	cp = cherry-pick
	f = fetch
	fo = fetch origin
	fod = fetch origin develop:develop
	fom = fetch origin main:main
	fop = fetch origin production:production
	fu = fetch upstream
	fum = fetch upstream main
	h = rev-parse HEAD
	l = log --graph --pretty=format:'%Cred[%h]%Creset%Cgreen[%ci]%C(bold blue)[%an]%Creset%C(yellow)%d%Creset %s'
	la = log --graph --all --pretty=format:'%Cred[%h]%Creset%Cgreen[%ci]%C(bold blue)[%an]%Creset%C(yellow)%d%Creset %s'
	pdo = push --delete origin
	po = push -u origin
	pob = !sh -c 'git push -u origin `git rp`'
	pom = push origin main
	pr = pull-request -b main
	prd = pull-request -b develop
  r = restore
	rp = rev-parse --abbrev-ref HEAD
	s = status --ignore-submodules=untracked
	save = stash save -u
	sn = status --untracked=no
	st = stash
	stashl = stash list --stat
	stashp = stash push -u
	stashs = stash show -p stash@{0}
	stat = status
	stl = stash list --stat
	stp = stash push -u
	sts = stash show -p stash@{0}
	sub = submodule
	suba = submodule add
	subu = submodule update --init
	sw = switch
	swc = switch -c
	swm = "!f(){ git switch -c ${1} main; }; f"
  lr = log --graph --pretty=format:'%Cred[%h]%Creset%Cgreen[%ci]%C(bold blue)[%an]%Creset%C(yellow)%d%Creset %s' --remotes='origin/release/*' main
  cleanb = "!f(){ for b in $(git b |grep jigish |grep -v '^+' |grep -v '^*'); do git bd $b; done; }; f"
  cleanbf = "!f(){ for b in $(git b |grep jigish |grep -v '^+' |grep -v '^*'); do git bdf $b; done; }; f"
[branch]
	autosetuprebase = always
[gc]
	auto = 0
[push]
	default = current
[url "git@github.com:"]
	insteadOf = https://github.com/
[delta]
	features = arctic-fox
[rerere]
	enabled = true
[commit]
  gpgsign = true
[tag]
  gpgSign = true
